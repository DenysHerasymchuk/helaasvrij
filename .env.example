POSTGRES_PASSWORD=CHANGE_ME
# GitHub OAuth App (optional; see README). Callback: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# route33 LLM gateway (never commit a real key)
R33_API_KEY=

# AI fallback through your own Claude Code CLI when route33 fails (see README "AI fallback with Claude Code").
# Leave LLM_FALLBACK empty to turn it off. Log in once with: docker compose exec api claude
LLM_FALLBACK=claude-cli

# GitHub REST token for source ingest (raises the 60/h limit); no scopes needed
GITHUB_TOKEN=

# Adzuna jobs API (shared snapshot, max 3 calls/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
